<Window x:Class="GerenciadorDeCarteira.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:web="clr-namespace:Microsoft.AspNetCore.Components.Web;assembly=Microsoft.AspNetCore.Components.Web"
        xmlns:telas="clr-namespace:GerenciadorDeCarteira.Components;assembly=Wal.UI"
        Title="Gerenciador de Carteira" Height="820" Width="1320" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Icon="app.ico"
        Background="{DynamicResource TitleBarBackgroundBrush}">
    <!-- Barra de título própria (como no jrstudio), com as cores do app. O WindowChrome mantém o comportamento
         nativo: arrastar para mover, encaixar nas bordas, duplo clique para maximizar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}"
                BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Gerenciador de Carteira" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TitleBarForegroundBrush}" FontSize="12" FontWeight="SemiBold"
                               FontFamily="Segoe UI" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}" Click="Minimizar_Click" ToolTip="Minimizar" />
                    <Button x:Name="MaximizarRestaurar" Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}"
                            Click="MaximizarRestaurar_Click" ToolTip="Maximizar" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseButtonStyle}" Click="Fechar_Click" ToolTip="Fechar" />
                </StackPanel>
            </Grid>
        </Border>

        <blazor:BlazorWebView Grid.Row="1" x:Name="BlazorWebView" HostPage="wwwroot\index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type telas:Routes}" />
                <blazor:RootComponent Selector="head::after" ComponentType="{x:Type web:HeadOutlet}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
