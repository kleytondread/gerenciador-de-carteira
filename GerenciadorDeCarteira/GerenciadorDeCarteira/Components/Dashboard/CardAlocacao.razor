@* Alocação por categoria (padrão) ou por classe (rosca do MudChart + tabela), ou por ativo (barras) *@

<CardPainel Titulo="Alocação" Class="@Class">
    <Acoes>
        <MudToggleGroup T="string" @bind-Value="visao" Size="Size.Small" Outlined="true" Delimiters="true"
                        Color="Color.Primary" aria-label="Agrupar por">
            <MudToggleItem T="string" Value="@VisaoClasse" Text="Classe" />
            <MudToggleItem T="string" Value="@VisaoCategoria" Text="Categoria" />
            <MudToggleItem T="string" Value="@VisaoAtivo" Text="Ativo" />
        </MudToggleGroup>
    </Acoes>
    <ChildContent>
        @if (visao != VisaoAtivo)
        {
            var rosca = visao == VisaoCategoria ? categorias : classes;
            var grupos = rosca.Grupos;
            <div class="wal-rosca">
                <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@rosca.Serie" ChartLabels="@rosca.Rotulos"
                          ChartOptions="@rosca.Opcoes" Width="210px" Height="210px" />
                <div class="wal-rosca-centro" aria-hidden="true">
                    <span class="wal-k">@Posicoes.Count ativos</span>
                    <span class="wal-rosca-total">@Formatacao.Moeda(total, Mascarar)</span>
                </div>
            </div>
            <MudSimpleTable Dense="true" Elevation="0" Class="wal-tabela">
                <thead>
                    <tr><th>@(visao == VisaoCategoria ? "Categoria" : "Classe")</th><th class="wal-num">Valor</th><th class="wal-num">Peso</th>
                        <th class="wal-num" title="Cotação atual sobre o preço médio, sem proventos">Valorização</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in grupos)
                    {
                        <tr>
                            <td><span class="wal-quadrado" style="background:@g.Cor"></span>@g.Nome</td>
                            <td class="wal-num">@Formatacao.Moeda(g.Valor, Mascarar)</td>
                            <td class="wal-num wal-forte">@Formatacao.PercentualSimples(g.Peso)</td>
                            <td class="wal-num @Formatacao.CorGanhoPerda(g.Valorizacao)">@(g.Valorizacao is decimal v ? Formatacao.Percentual(v) : "–")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        else
        {
            <ul class="wal-barras-ativos" aria-label="Peso de cada ativo">
                @foreach (var p in ativos)
                {
                    <li>
                        <a href="posicoes/@p.AtivoId" class="wal-forte">@p.Ticker</a>
                        <span class="wal-barra-trilho"><span style="width:@Formatacao.LarguraCss(p.Peso ?? 0, maiorPeso);background:@CoresSeries.Cor(p.Tipo)"></span></span>
                        <span class="wal-num">@Formatacao.PercentualSimples(p.Peso ?? 0)</span>
                    </li>
                }
            </ul>
        }
    </ChildContent>
</CardPainel>

@code {
    [Parameter, EditorRequired] public List<PosicaoDetalhadaResponse> Posicoes { get; set; } = [];

    [Parameter] public bool Mascarar { get; set; }

    [Parameter] public string? Class { get; set; }

    private const string VisaoClasse = "classe";
    private const string VisaoCategoria = "categoria";
    private const string VisaoAtivo = "ativo";

    /// <summary>Uma fatia da rosca e uma linha da tabela.</summary>
    private sealed record Grupo(string Nome, string Cor, decimal Valor, decimal Peso, decimal? Valorizacao);

    // Sempre abre em Categoria (Brasil RV / Dólar RV / Renda Fixa), a visão usada no controle da planilha
    private string visao = VisaoCategoria;
    private decimal total;
    private Rosca classes = Rosca.Vazia;
    private Rosca categorias = Rosca.Vazia;
    private List<PosicaoDetalhadaResponse> ativos = [];
    // Barras proporcionais ao maior peso, para as diferenças aparecerem mesmo entre pesos pequenos
    private decimal maiorPeso;

    protected override void OnParametersSet()
    {
        total = Posicoes.Sum(p => p.Valor ?? 0);
        classes = Rosca.De(CoresSeries.OrdemClasses
            .Select(t => Agrupar(CoresSeries.NomeClasse(t), CoresSeries.Cor(t), Posicoes.Where(p => p.Tipo == t))));
        categorias = Rosca.De(CoresSeries.OrdemCategorias
            .Select(c => Agrupar(CoresSeries.NomeCategoria(c), CoresSeries.Cor(c), Posicoes.Where(p => p.Categoria == c))));
        ativos = Posicoes.OrderByDescending(p => p.Valor ?? 0).ToList();
        maiorPeso = ativos.Count > 0 ? ativos.Max(p => p.Peso ?? 0) : 0;
    }

    private Grupo Agrupar(string nome, string cor, IEnumerable<PosicaoDetalhadaResponse> posicoes)
    {
        var lista = posicoes.ToList();
        var valor = lista.Sum(p => p.Valor ?? 0);
        var custo = lista.Sum(p => p.Custo);
        return new Grupo(nome, cor, valor, total > 0 ? valor / total : 0, custo > 0 ? valor / custo - 1 : null);
    }

    /// <summary>Dados prontos da rosca, montados uma vez por atualização (não a cada renderização).</summary>
    private sealed record Rosca(List<Grupo> Grupos, List<ChartSeries<double>> Serie, string[] Rotulos, DonutChartOptions Opcoes)
    {
        public static readonly Rosca Vazia = De([]);

        public static Rosca De(IEnumerable<Grupo> todos)
        {
            var grupos = todos.Where(g => g.Valor > 0).ToList();
            return new Rosca(
                grupos,
                [new ChartSeries<double> { Name = "Alocação", Data = new ChartData<double>(grupos.Select(g => (double)g.Valor).ToList()) }],
                grupos.Select(g => g.Nome).ToArray(),
                // A tabela abaixo é a legenda; tooltip mostraria R$ mesmo com os valores ocultos
                new DonutChartOptions { ChartPalette = grupos.Select(g => g.Cor).ToArray(), ShowLegend = false, ShowToolTips = false });
        }
    }
}
