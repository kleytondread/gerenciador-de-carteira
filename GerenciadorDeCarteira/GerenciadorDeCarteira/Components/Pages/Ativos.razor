@page "/ativos"
@using System.ComponentModel.DataAnnotations
@* DbContext próprio por página — ver comentário em Home.razor *@
@inherits OwningComponentBase
@inject IJSRuntime JsRuntime

<PageTitle>Ativos rastreados - Gestor de Carteira B3</PageTitle>
<SectionContent SectionName="@TituloPagina.Secao">Ativos rastreados</SectionContent>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Cadastrar novo ativo</h5>
        <EditForm Model="novoAtivo" OnValidSubmit="CadastrarAsync">
            <DataAnnotationsValidator />
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label mb-0">Tipo</label>
                    <InputSelect @bind-Value="novoAtivo.Tipo" @bind-Value:after="OnTipoAlteradoAsync" class="form-select">
                        <option value="@TipoAtivo.Acao">Ação</option>
                        <option value="@TipoAtivo.ETF">ETF</option>
                        <option value="@TipoAtivo.FII">FII</option>
                        <option value="@TipoAtivo.BDR">BDR</option>
                        <option value="@TipoAtivo.Tesouro">Tesouro</option>
                    </InputSelect>
                </div>
                @if (novoAtivo.Tipo == TipoAtivo.Tesouro)
                {
                    <div class="col-auto">
                        <label class="form-label mb-0">Tipo de título</label>
                        <select class="form-select" @bind="filtroCategoria" @bind:after="OnFiltroCategoriaAlterado"
                                disabled="@carregandoTitulos">
                            <option value="">Todos</option>
                            @foreach (var categoria in TitulosTesouro.Categorias)
                            {
                                <option value="@categoria">@categoria</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0">Título</label>
                        <input class="form-control" list="titulos-tesouro" style="width:380px"
                               placeholder="@(carregandoTitulos ? "Carregando títulos..." : "Pesquise pelo nome (ex.: IPCA+ 2045)")"
                               disabled="@carregandoTitulos"
                               @bind="novoAtivo.BuscaTitulo" @bind:event="oninput" @bind:after="SelecionarTituloPelaBusca" />
                        <datalist id="titulos-tesouro">
                            @foreach (var titulo in TitulosFiltrados)
                            {
                                <option value="@RotuloTitulo(titulo)"></option>
                            }
                        </datalist>
                    </div>
                }
                else
                {
                    <div class="col-auto">
                        <label class="form-label mb-0">Ticker</label>
                        <InputText Value="@novoAtivo.Ticker" ValueChanged="OnTickerChanged" ValueExpression="() => novoAtivo.Ticker"
                                   class="form-control" placeholder="PETR4" style="width:140px" maxlength="6" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0">Nome</label>
                        <InputText @bind-Value="novoAtivo.Nome" class="form-control" placeholder="Petrobras PN" style="width:280px" />
                    </div>
                }
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary" disabled="@salvandoNovo">
                        @if (salvandoNovo)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Cadastrar
                    </button>
                </div>
            </div>
            @if (novoAtivo.Tipo == TipoAtivo.Tesouro)
            {
                @if (erroTitulos is not null)
                {
                    <div class="text-danger small mt-2">@erroTitulos</div>
                }
                else if (novoAtivo.TituloSelecionado is { } sel)
                {
                    <div class="text-muted small mt-2">
                        Será cadastrado como <strong>@sel.Ticker</strong> — vencimento @sel.Vencimento.ToString("dd/MM/yyyy"),
                        preço de @sel.UltimoPreco.ToString("C2", Formatacao.PtBR) em @sel.DataUltimoPreco.ToString("dd/MM/yyyy")
                        @if (sel.TaxaCompra is decimal taxa)
                        {
                            <span class="ms-1">(taxa de compra @taxa.ToString("N2", Formatacao.PtBR)%)</span>
                        }
                    </div>
                }
                else if (!carregandoTitulos)
                {
                    <div class="text-muted small mt-2">@TitulosFiltrados.Count() título(s) disponível(is). Preços: Tesouro Transparente.</div>
                }
            }
            <ValidationSummary class="text-danger mt-2 mb-0" />
        </EditForm>

        @if (erroCadastro is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@erroCadastro</div>
        }
        @if (mensagemCadastro is not null)
        {
            <div class="alert alert-success mt-3 mb-0">@mensagemCadastro</div>
        }
    </div>
</div>

<div class="d-flex gap-2 mb-3 align-items-center">
    <input class="form-control" style="max-width:280px" placeholder="Buscar por ticker ou nome"
           @bind="busca" @bind:event="oninput" @onkeydown="OnBuscaKeyDown" />
    <button class="btn btn-outline-secondary" @onclick="CarregarAsync">Buscar</button>
    <div class="form-check ms-3">
        <input class="form-check-input" type="checkbox" id="incluirInativos" @bind="incluirInativos" @bind:after="CarregarAsync" />
        <label class="form-check-label" for="incluirInativos">Incluir inativos</label>
    </div>
</div>

@if (erroLista is not null)
{
    <div class="alert alert-danger">@erroLista</div>
}

@if (carregandoLista)
{
    <p class="text-muted">Carregando...</p>
}
else if (ativos.Count == 0)
{
    <p class="text-muted">Nenhum ativo encontrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr>
                    <th>Ticker</th>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Status</th>
                    <th>Cadastro</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ativo in ativos)
                {
                    <tr>
                        @if (edicaoId == ativo.Id)
                        {
                            <td class="fw-semibold text-muted" title="Ticker não é editável — se errou, exclua e recadastre.">@ativo.Ticker</td>
                            <td><input class="form-control form-control-sm" @bind="nomeEdicao" /></td>
                            <td>
                                @if (ativo.Tipo == TipoAtivo.Tesouro)
                                {
                                    @* Título do Tesouro não troca de tipo (a cotação vem de outra fonte) *@
                                    <span class="text-muted">@Formatacao.NomeTipo(ativo.Tipo)</span>
                                }
                                else
                                {
                                    <select class="form-select form-select-sm" @bind="tipoEdicao">
                                        <option value="@TipoAtivo.Acao">Ação</option>
                                        <option value="@TipoAtivo.ETF">ETF</option>
                                        <option value="@TipoAtivo.FII">FII</option>
                                        <option value="@TipoAtivo.BDR">BDR</option>
                                    </select>
                                }
                            </td>
                            <td>@(ativo.EstaAtivo ? "Ativo" : "Inativo")</td>
                            <td>@ativo.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-success me-1" @onclick="() => SalvarEdicaoAsync(ativo.Id)" disabled="@salvandoEdicao">Salvar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelarEdicao">Cancelar</button>
                            </td>
                        }
                        else
                        {
                            <td class="fw-semibold">@ativo.Ticker</td>
                            <td>@ativo.Nome</td>
                            <td>@Formatacao.NomeTipo(ativo.Tipo)</td>
                            <td>
                                <span class="badge @(ativo.EstaAtivo ? "bg-success" : "bg-secondary")">
                                    @(ativo.EstaAtivo ? "Ativo" : "Inativo")
                                </span>
                            </td>
                            <td>@ativo.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => IniciarEdicao(ativo)">Editar</button>
                                @if (ativo.EstaAtivo)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DesativarAsync(ativo)">Desativar</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => ReativarAsync(ativo)">Reativar</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IAtivoService AtivoService => ScopedServices.GetRequiredService<IAtivoService>();
    private ITesouroDiretoService TesouroDireto => ScopedServices.GetRequiredService<ITesouroDiretoService>();

    // Títulos do Tesouro para o cadastro: carregados na primeira vez que o tipo Tesouro é escolhido
    private List<TituloTesouroResponse>? titulosTesouro;
    private bool carregandoTitulos;
    private string? erroTitulos;
    private string filtroCategoria = string.Empty;

    private IEnumerable<TituloTesouroResponse> TitulosFiltrados =>
        (titulosTesouro ?? []).Where(t => filtroCategoria == string.Empty || t.Categoria == filtroCategoria);

    private static string RotuloTitulo(TituloTesouroResponse t) => $"{t.Nome} — venc. {t.Vencimento:dd/MM/yyyy}";

    // Serializa as recargas da lista: Buscar/Enter/checkbox podem disparar quase juntos, e o
    // DbContext não aceita duas operações simultâneas.
    private readonly SemaphoreSlim cargaLock = new(1, 1);

    private List<AtivoResponse> ativos = [];
    private bool carregandoLista;
    private string? erroLista;

    private string busca = string.Empty;
    private bool incluirInativos = true;

    private NovoAtivoModel novoAtivo = new();
    private bool salvandoNovo;
    private string? erroCadastro;
    private string? mensagemCadastro;

    private int? edicaoId;
    private string nomeEdicao = string.Empty;
    private TipoAtivo tipoEdicao;
    private bool salvandoEdicao;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        await cargaLock.WaitAsync();
        carregandoLista = true;
        erroLista = null;
        try
        {
            ativos = await AtivoService.ListarAsync(busca, incluirInativos);
        }
        finally
        {
            carregandoLista = false;
            cargaLock.Release();
        }
    }

    private async Task OnBuscaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CarregarAsync();
    }

    private void OnTickerChanged(string valor) =>
        novoAtivo.Ticker = (valor ?? string.Empty).Trim().ToUpperInvariant();

    private async Task OnTipoAlteradoAsync()
    {
        if (novoAtivo.Tipo != TipoAtivo.Tesouro || titulosTesouro is not null) return;

        carregandoTitulos = true;
        erroTitulos = null;
        try
        {
            // Pode baixar o arquivo do Tesouro (se o salvo tiver 5h ou mais), o que leva alguns segundos
            titulosTesouro = await TesouroDireto.ListarTitulosAsync();
            if (titulosTesouro.Count == 0)
            {
                erroTitulos = "A lista de títulos do Tesouro está indisponível agora (o arquivo de preços não pôde ser baixado). Tente mais tarde.";
                titulosTesouro = null; // tenta de novo na próxima vez que o tipo for escolhido
            }
        }
        catch (Exception)
        {
            erroTitulos = "Não foi possível ler a lista de títulos do Tesouro. Tente mais tarde.";
            titulosTesouro = null;
        }
        finally
        {
            carregandoTitulos = false;
        }
    }

    private void OnFiltroCategoriaAlterado()
    {
        // O título escolhido pode não ser da nova categoria
        if (novoAtivo.TituloSelecionado is { } sel && filtroCategoria != string.Empty && sel.Categoria != filtroCategoria)
        {
            novoAtivo.TituloSelecionado = null;
            novoAtivo.BuscaTitulo = string.Empty;
        }
    }

    // O campo de busca é texto livre com sugestões; o título só conta como escolhido quando o texto
    // é exatamente uma das sugestões
    private void SelecionarTituloPelaBusca() =>
        novoAtivo.TituloSelecionado = TitulosFiltrados.FirstOrDefault(t => RotuloTitulo(t) == novoAtivo.BuscaTitulo);

    private async Task CadastrarAsync()
    {
        salvandoNovo = true;
        erroCadastro = null;
        mensagemCadastro = null;
        try
        {
            var titulo = novoAtivo.TituloSelecionado;
            var request = novoAtivo.Tipo == TipoAtivo.Tesouro && titulo is not null
                ? new CriarAtivoRequest(titulo.Ticker, titulo.Nome, TipoAtivo.Tesouro, titulo.TipoTitulo, titulo.Vencimento)
                : new CriarAtivoRequest(novoAtivo.Ticker, novoAtivo.Nome, novoAtivo.Tipo);
            var resultado = await AtivoService.CriarAsync(request);
            if (resultado.Sucesso)
            {
                mensagemCadastro = novoAtivo.Tipo == TipoAtivo.Tesouro
                    ? $"Título {resultado.Valor!.Nome} cadastrado como {resultado.Valor.Ticker}. O histórico de preços está sendo carregado em segundo plano."
                    : $"Ativo {resultado.Valor!.Ticker} cadastrado. A busca do histórico de cotações e proventos foi iniciada em segundo plano.";
                // Mantém o tipo escolhido, para cadastrar vários títulos em sequência
                novoAtivo = new NovoAtivoModel { Tipo = novoAtivo.Tipo };
                await CarregarAsync();
            }
            else
            {
                erroCadastro = resultado.Erro;
            }
        }
        finally
        {
            salvandoNovo = false;
        }
    }

    private void IniciarEdicao(AtivoResponse ativo)
    {
        edicaoId = ativo.Id;
        nomeEdicao = ativo.Nome;
        tipoEdicao = ativo.Tipo;
    }

    private void CancelarEdicao() => edicaoId = null;

    private async Task SalvarEdicaoAsync(int id)
    {
        salvandoEdicao = true;
        erroLista = null;
        try
        {
            var resultado = await AtivoService.EditarAsync(id, new EditarAtivoRequest(nomeEdicao, tipoEdicao));
            if (resultado.Sucesso)
            {
                edicaoId = null;
                await CarregarAsync();
            }
            else
            {
                erroLista = resultado.Erro;
            }
        }
        finally
        {
            salvandoEdicao = false;
        }
    }

    private async Task DesativarAsync(AtivoResponse ativo)
    {
        var confirmado = await JsRuntime.InvokeAsync<bool>("confirm", $"Desativar o ativo {ativo.Ticker}?");
        if (!confirmado) return;

        erroLista = null;
        var resultado = await AtivoService.ExcluirAsync(ativo.Id);
        if (resultado.Sucesso)
        {
            await CarregarAsync();
        }
        else
        {
            erroLista = resultado.Erro;
        }
    }

    private async Task ReativarAsync(AtivoResponse ativo)
    {
        erroLista = null;
        var resultado = await AtivoService.ReativarAsync(ativo.Id);
        if (resultado.Sucesso)
            await CarregarAsync();
        else
            erroLista = resultado.Erro;
    }

    // As regras dependem do tipo (Tesouro não tem ticker nem nome digitados), por isso a validação
    // fica em Validate e não em atributos por campo
    private class NovoAtivoModel : IValidatableObject
    {
        // Mesmo regex do AtivoService (backend)
        private static readonly System.Text.RegularExpressions.Regex TickerB3 = new(@"^[A-Z][A-Z0-9]{3}\d{1,2}$");

        public string Ticker { get; set; } = string.Empty;
        public string Nome { get; set; } = string.Empty;
        public TipoAtivo Tipo { get; set; } = TipoAtivo.Acao;

        // Tesouro: texto digitado na busca e o título correspondente da lista
        public string BuscaTitulo { get; set; } = string.Empty;
        public TituloTesouroResponse? TituloSelecionado { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Tipo == TipoAtivo.Tesouro)
            {
                if (TituloSelecionado is null)
                    yield return new ValidationResult("Selecione um título da lista.", [nameof(BuscaTitulo)]);
                yield break;
            }

            if (string.IsNullOrWhiteSpace(Ticker))
                yield return new ValidationResult("Informe o ticker.", [nameof(Ticker)]);
            else if (!TickerB3.IsMatch(Ticker))
                yield return new ValidationResult(
                    "Ticker deve seguir o formato B3: 4 caracteres iniciando por letra + 1-2 dígitos (ex: PETR4, HGLG11, B5P211).",
                    [nameof(Ticker)]);

            if (string.IsNullOrWhiteSpace(Nome))
                yield return new ValidationResult("Informe o nome.", [nameof(Nome)]);
        }
    }
}
