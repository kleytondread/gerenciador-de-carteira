@page "/posicoes/{Id:int}"
@page "/ativos/{Id:int}"
@using System.ComponentModel.DataAnnotations
@* DbContext próprio por página — ver comentário em Home.razor *@
@inherits OwningComponentBase
@inject IJSRuntime JsRuntime
@inject NotificacoesCarteira Notificacoes

<PageTitle>@(ativo?.Ticker ?? "Ativo") - Gestor de Carteira B3</PageTitle>
<SectionContent SectionName="@TituloPagina.Secao">
    <span class="wal-trilha"><a href="posicoes">Posições</a><span aria-hidden="true">›</span>@(ativo?.Ticker ?? "Ativo")</span>
</SectionContent>

@if (carregando)
{
    <p class="text-muted">Carregando...</p>
}
else if (ativo is null)
{
    <div class="alert alert-warning">Ativo não encontrado. <a href="/" class="alert-link">Voltar à carteira</a></div>
}
else
{
    @* 9.1 — Cabeçalho *@
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-1">
        <div>
            <h3 class="mb-0">
                @ativo.Ticker
                <span class="badge bg-secondary fs-6 align-middle">@Formatacao.NomeTipo(ativo.Tipo)</span>
                @if (!ativo.EstaAtivo)
                {
                    <span class="badge bg-warning text-dark fs-6 align-middle">Inativo</span>
                }
            </h3>
            <div class="text-muted">@ativo.Nome</div>
        </div>
        <div class="text-end">
            @if (ultimaCotacao is not null)
            {
                <div class="fs-3 fw-semibold">@ultimaCotacao.Fechamento.ToString("C2", PtBR)</div>
                @if (variacaoDiaReais is decimal vr && variacaoDiaPercentual is decimal vp)
                {
                    <div class="@CorGanhoPerda(vr)">
                        @FormatarComSinal(vr) (@FormatarPercentual(vp))
                        <span class="text-muted">no dia</span>
                    </div>
                }
                <small class="text-muted">Último pregão: @ultimaCotacao.Data.ToString("dd/MM/yyyy")</small>
            }
            else
            {
                <div class="text-muted">
                    Sem cotações ainda — a carga histórica pode estar em andamento.
                </div>
            }
        </div>
    </div>

    @* Título do Tesouro tem um preço por dia, sem máxima, mínima ou volume *@
    @if (ultimaCotacao is not null && ativo.Tipo != TipoAtivo.Tesouro)
    {
        <div class="d-flex flex-wrap gap-4 text-muted small mb-4">
            <span>Máxima do dia: <strong>@ultimaCotacao.Maxima.ToString("C2", PtBR)</strong></span>
            <span>Mínima do dia: <strong>@ultimaCotacao.Minima.ToString("C2", PtBR)</strong></span>
            <span>Volume: <strong>@ultimaCotacao.Volume.ToString("N0", PtBR)</strong></span>
        </div>
    }

    @* 9.2 — Gráfico de cotação histórica com seletor de período *@
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="card-title text-muted mb-0">Cotação histórica</h6>
                <div class="btn-group btn-group-sm" role="group" aria-label="Período do gráfico">
                    @foreach (var p in Periodos)
                    {
                        <button type="button"
                                class="btn @(periodoSelecionado == p ? "btn-primary" : "btn-outline-primary")"
                                disabled="@carregandoGrafico"
                                @onclick="() => TrocarPeriodoAsync(p)">@p</button>
                    }
                </div>
            </div>
            @if (cotacoesGrafico.Count == 0)
            {
                <p class="text-muted mb-0">Nenhuma cotação disponível para o período.</p>
            }
            else
            {
                <div style="height:320px">
                    <canvas id="grafico-cotacao-ativo"></canvas>
                </div>
                <p class="text-muted small mb-0 mt-2">Clique e arraste no gráfico para ver a variação no período.</p>
            }
        </div>
    </div>

    @* 9.3 — Posição do usuário + histórico de movimentações *@
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="card-title text-muted mb-0">Minha posição</h6>
                @* 9.4 — Atalho para nova movimentação *@
                @if (ativo.EstaAtivo)
                {
                    <button type="button" class="btn btn-sm btn-primary" @onclick="AlternarFormulario">
                        @(exibirFormulario ? "Fechar" : "Nova movimentação")
                    </button>
                }
                else
                {
                    <small class="text-muted">Ativo inativo — reative-o na <a href="ativos">tela de ativos</a> para lançar movimentações.</small>
                }
            </div>

            @if (exibirFormulario)
            {
                <div class="border rounded p-3 mb-3">
                    <EditForm Model="movModel" OnValidSubmit="RegistrarMovimentacaoAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-2 align-items-end">
                            <div class="col-auto">
                                <label class="form-label mb-0">Tipo</label>
                                <InputSelect @bind-Value="movModel.Tipo" @bind-Value:after="AtualizarPosicaoNaDataAsync" class="form-select form-select-sm">
                                    <option value="@TipoMovimentacao.Compra">Compra</option>
                                    <option value="@TipoMovimentacao.Venda">Venda</option>
                                </InputSelect>
                            </div>
                            <div class="col-auto">
                                <label class="form-label mb-0">Data</label>
                                <InputDate @bind-Value="movModel.Data" @bind-Value:after="AtualizarPosicaoNaDataAsync"
                                           class="form-control form-control-sm" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-auto">
                                <label class="form-label mb-0">Quantidade</label>
                                <InputNumber @bind-Value="movModel.Quantidade" class="form-control form-control-sm" style="width:110px" />
                            </div>
                            <div class="col-auto">
                                <label class="form-label mb-0">Preço unitário</label>
                                <InputNumber @bind-Value="movModel.PrecoUnitario" class="form-control form-control-sm" style="width:110px" />
                            </div>
                            <div class="col-auto">
                                <label class="form-label mb-0">Taxas</label>
                                <InputNumber @bind-Value="movModel.Taxas" class="form-control form-control-sm" style="width:90px" />
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-sm btn-success" disabled="@salvandoMovimentacao">
                                    @if (salvandoMovimentacao)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    }
                                    Registrar
                                </button>
                            </div>
                        </div>
                        @if (movModel.Tipo == TipoMovimentacao.Venda && posicaoNaData is not null)
                        {
                            <small class="text-muted d-block mt-2">
                                Disponível para venda em @movModel.Data.ToString("dd/MM/yyyy"):
                                <strong>@Formatacao.Quantidade(posicaoNaData.Quantidade)</strong>
                            </small>
                        }
                        <ValidationSummary class="text-danger mt-2 mb-0" />
                    </EditForm>
                    @if (erroMovimentacao is not null)
                    {
                        <div class="alert alert-danger mt-2 mb-0 py-2">@erroMovimentacao</div>
                    }
                    @if (mensagemMovimentacao is not null)
                    {
                        <div class="alert alert-success mt-2 mb-0 py-2">@mensagemMovimentacao</div>
                    }
                </div>
            }

            @if (posicao is null || posicao.Quantidade <= 0)
            {
                <p class="text-muted mb-0">
                    Você não tem posição neste ativo — registre uma compra pelo botão acima para começar.
                </p>
            }
            else
            {
                <div class="row g-3 mb-1">
                    <div class="col-6 col-md-2">
                        <div class="text-muted small">Quantidade</div>
                        <div class="fw-semibold">@posicao.Quantidade.ToString("N4", PtBR)</div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="text-muted small">Preço médio</div>
                        <div class="fw-semibold">@posicao.PrecoMedio.ToString("C2", PtBR)</div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="text-muted small">Valor investido</div>
                        <div class="fw-semibold">@ValorInvestido.ToString("C2", PtBR)</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted small">Valor atual</div>
                        <div class="fw-semibold">@(ValorAtual?.ToString("C2", PtBR) ?? "—")</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted small">Rentabilidade</div>
                        <div class="fw-semibold @CorGanhoPerda(Rentabilidade)">
                            @(Rentabilidade is decimal r ? FormatarPercentual(r) : "—")
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h6 class="card-title text-muted">Movimentações deste ativo</h6>
            @if (movimentacoes.Count == 0)
            {
                <p class="text-muted mb-0">Nenhuma movimentação registrada para este ativo.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Data</th>
                                <th class="text-end">Quantidade</th>
                                <th class="text-end">Preço unitário</th>
                                <th class="text-end">Taxas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in movimentacoes)
                            {
                                <tr>
                                    <td>
                                        <span class="badge @(m.Tipo == TipoMovimentacao.Compra ? "bg-success" : "bg-danger")">@m.Tipo</span>
                                    </td>
                                    <td>@m.Data.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@m.Quantidade.ToString("N4", PtBR)</td>
                                    <td class="text-end">@m.PrecoUnitario.ToString("C4", PtBR)</td>
                                    <td class="text-end">@m.Taxas.ToString("C2", PtBR)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <small class="text-muted">
                    Para editar ou excluir, use a <a href="movimentacoes?ativoId=@ativo.Id">tela de movimentações</a>.
                </small>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    // Os mesmos da Home, sem o 5D: a cotação é diária, então 5 pontos dizem pouco
    private static readonly string[] Periodos = ["1M", "6M", "1A", "YTD", "24M", "Início"];

    private static readonly System.Globalization.CultureInfo PtBR = Formatacao.PtBR;

    private IAtivoService AtivoService => ScopedServices.GetRequiredService<IAtivoService>();
    private IMovimentacaoService MovimentacaoService => ScopedServices.GetRequiredService<IMovimentacaoService>();
    private IPosicaoService PosicaoService => ScopedServices.GetRequiredService<IPosicaoService>();

    private bool carregando = true;
    private int? idCarregado;
    private AtivoResponse? ativo;

    // 9.1 — cabeçalho: dados do último pregão (últimos 2 fechamentos para variação do dia)
    private CotacaoResponse? ultimaCotacao;
    private decimal? variacaoDiaReais;
    private decimal? variacaoDiaPercentual;

    // 9.2 — gráfico
    private string periodoSelecionado = "6M";
    private List<CotacaoResponse> cotacoesGrafico = [];
    private bool precisaRenderizarGrafico;
    private bool graficoCriado;
    private bool carregandoGrafico;

    // 9.3 — posição + histórico
    private PosicaoCalculada? posicao;
    private PosicaoCalculada? posicaoNaData; // posição disponível na data escolhida no formulário de venda
    private List<MovimentacaoResponse> movimentacoes = [];

    // 9.4 — atalho de movimentação
    private bool exibirFormulario;
    private MovimentacaoModel movModel = new();
    private bool salvandoMovimentacao;
    private string? erroMovimentacao;
    private string? mensagemMovimentacao;

    private decimal ValorInvestido => posicao is null ? 0 : posicao.Quantidade * posicao.PrecoMedio;
    private decimal? ValorAtual => posicao is not null && ultimaCotacao is not null
        ? posicao.Quantidade * ultimaCotacao.Fechamento : null;
    private decimal? Rentabilidade => posicao is { PrecoMedio: not 0 } && ultimaCotacao is not null
        ? (ultimaCotacao.Fechamento - posicao.PrecoMedio) / posicao.PrecoMedio : null;

    protected override async Task OnParametersSetAsync()
    {
        // OnParametersSetAsync também roda em re-renders do pai sem troca de ativo — só recarrega se o Id mudou
        if (idCarregado == Id) return;
        idCarregado = Id;

        // Navegação de um ativo para outro reaproveita a mesma instância: zera o estado do formulário
        exibirFormulario = false;
        movModel = new MovimentacaoModel();
        posicaoNaData = null;
        erroMovimentacao = null;
        mensagemMovimentacao = null;

        carregando = true;
        ativo = (await AtivoService.ObterPorIdAsync(Id)).Valor;

        if (ativo is not null)
        {
            await CarregarCabecalhoAsync();
            await CarregarGraficoAsync();
            await CarregarPosicaoEMovimentacoesAsync();
        }

        carregando = false;
    }

    private async Task CarregarCabecalhoAsync()
    {
        // 1M é suficiente para obter os dois últimos pregões (variação do dia)
        var resultado = await AtivoService.ObterCotacoesAsync(Id, "1M");
        var serie = resultado.Valor ?? [];

        ultimaCotacao = serie.Count > 0 ? serie[^1] : null;
        if (serie.Count >= 2 && serie[^2].Fechamento != 0)
        {
            variacaoDiaReais = serie[^1].Fechamento - serie[^2].Fechamento;
            variacaoDiaPercentual = variacaoDiaReais / serie[^2].Fechamento;
        }
        else
        {
            variacaoDiaReais = null;
            variacaoDiaPercentual = null;
        }
    }

    private async Task CarregarGraficoAsync()
    {
        carregandoGrafico = true;
        try
        {
            var resultado = await AtivoService.ObterCotacoesAsync(Id, periodoSelecionado);
            cotacoesGrafico = resultado.Valor ?? [];
            // Sempre sincroniza com o JS: sem dados, o renderLine apenas destrói o gráfico anterior
            precisaRenderizarGrafico = true;
        }
        finally
        {
            carregandoGrafico = false;
        }
    }

    private async Task CarregarPosicaoEMovimentacoesAsync()
    {
        posicao = await PosicaoService.CalcularPosicaoAsync(Id);
        movimentacoes = await MovimentacaoService.ListarAsync(Id);
    }

    private async Task AtualizarPosicaoNaDataAsync()
    {
        posicaoNaData = movModel.Tipo == TipoMovimentacao.Venda
            ? await PosicaoService.CalcularPosicaoAsync(Id, movModel.Data)
            : null;
    }

    private async Task TrocarPeriodoAsync(string periodo)
    {
        // Ignora cliques enquanto um período ainda carrega (evita duas consultas simultâneas no DbContext)
        if (periodo == periodoSelecionado || carregandoGrafico) return;
        periodoSelecionado = periodo;
        await CarregarGraficoAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!precisaRenderizarGrafico) return;
        precisaRenderizarGrafico = false;

        var labels = cotacoesGrafico.Select(c => c.Data.ToString("dd/MM/yy")).ToArray();
        var valores = cotacoesGrafico.Select(c => c.Fechamento).ToArray();

        await JsRuntime.InvokeVoidAsync("walCharts.renderLine",
            "grafico-cotacao-ativo", labels, valores, "Fechamento", new { medirVariacao = true });
        graficoCriado = true;
    }

    private void AlternarFormulario()
    {
        exibirFormulario = !exibirFormulario;
        erroMovimentacao = null;
        mensagemMovimentacao = null;
        posicaoNaData = null;
        movModel = new MovimentacaoModel();
    }

    private async Task RegistrarMovimentacaoAsync()
    {
        salvandoMovimentacao = true;
        erroMovimentacao = null;
        mensagemMovimentacao = null;
        try
        {
            var request = new CriarMovimentacaoRequest(
                Id, movModel.Tipo, movModel.Data, movModel.Quantidade, movModel.PrecoUnitario, movModel.Taxas);
            var resultado = await MovimentacaoService.CriarAsync(request);

            if (resultado.Sucesso)
            {
                mensagemMovimentacao = "Movimentação registrada.";
                Notificacoes.NotificarAlteracao();
                movModel = new MovimentacaoModel();
                posicaoNaData = null;
                // Atualiza posição e histórico na própria tela, sem reload (Tarefa 9.4)
                await CarregarPosicaoEMovimentacoesAsync();
            }
            else
            {
                erroMovimentacao = resultado.Erro;
            }
        }
        finally
        {
            salvandoMovimentacao = false;
        }
    }

    private static string CorGanhoPerda(decimal? valor) => Formatacao.CorGanhoPerda(valor);

    private static string FormatarComSinal(decimal valor) => Formatacao.MoedaComSinal(valor);

    private static string FormatarPercentual(decimal fracao) => Formatacao.Percentual(fracao);

    protected override async ValueTask DisposeAsyncCore()
    {
        // Só há o que destruir se o gráfico foi criado via interop (OnAfterRenderAsync interativo).
        // A instância do prerender estático também é descartada, e nela interop nem é permitido
        // (lançaria InvalidOperationException) — por isso o flag, e não um try/catch mais largo.
        if (graficoCriado)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("walCharts.destroy", "grafico-cotacao-ativo");
            }
            catch (JSDisconnectedException)
            {
                // Circuito já encerrado — nada a limpar no browser.
            }
        }

        await base.DisposeAsyncCore();
    }

    private class MovimentacaoModel
    {
        public TipoMovimentacao Tipo { get; set; } = TipoMovimentacao.Compra;

        public DateOnly Data { get; set; } = DateOnly.FromDateTime(DateTime.Today);

        [Range(0.0001, double.MaxValue, ErrorMessage = "Quantidade deve ser maior que zero.")]
        public decimal Quantidade { get; set; }

        [Range(0.0001, double.MaxValue, ErrorMessage = "Preço unitário deve ser maior que zero.")]
        public decimal PrecoUnitario { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Taxas não pode ser negativo.")]
        public decimal Taxas { get; set; }
    }
}
