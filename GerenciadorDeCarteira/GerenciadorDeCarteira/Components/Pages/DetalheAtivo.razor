@page "/posicoes/{Id:int}"
@page "/ativos/{Id:int}"
@* DbContext próprio por página — ver comentário em Home.razor *@
@inherits OwningComponentBase
@inject PreferenciasExibicao Preferencias
@inject ISnackbar Snackbar

<PageTitle>@(detalhe?.Ativo.Ticker ?? "Ativo") - Gestor de Carteira B3</PageTitle>
<SectionContent SectionName="@TituloPagina.Secao">
    <span class="wal-trilha"><a href="posicoes">Posições</a><span aria-hidden="true">›</span>@(detalhe?.Ativo.Ticker ?? "Ativo")</span>
</SectionContent>

@if (carregando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Carregando o ativo" />
}
else if (detalhe is null)
{
    <MudAlert Severity="Severity.Warning">Ativo não encontrado. <MudLink Href="posicoes">Voltar às posições</MudLink></MudAlert>
}
else
{
    var ativo = detalhe.Ativo;
    var pregao = detalhe.Pregao;
    <div class="wal-painel">
        @* Cabeçalho do ativo + indicadores da posição *@
        <MudPaper Outlined="true" Class="wal-card wal-s12">
            <div class="wal-ativo-cabecalho">
                <div class="wal-ativo-id">
                    <span class="wal-ativo-avatar" aria-hidden="true">@ativo.Ticker[..Math.Min(2, ativo.Ticker.Length)]</span>
                    <div>
                        <div class="wal-ativo-titulo">
                            <span class="wal-ativo-ticker">@ativo.Ticker</span>
                            @if (!string.Equals(ativo.Nome, ativo.Ticker, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="wal-k wal-ativo-nome">@ativo.Nome</span>
                            }
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Formatacao.NomeTipo(ativo.Tipo)</MudChip>
                            @if (!ativo.EstaAtivo)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Rastreamento pausado</MudChip>
                            }
                        </div>
                        @if (pregao is not null)
                        {
                            <div class="wal-ativo-preco">
                                <span class="wal-ativo-cotacao">@Formatacao.Moeda(pregao.Fechamento)</span>
                                @if (pregao.VariacaoReais is decimal vr && pregao.VariacaoPercentual is decimal vp)
                                {
                                    <span class="@Formatacao.CorGanhoPerda(vr) wal-forte">@Formatacao.MoedaComSinal(vr) (@Formatacao.Percentual(vp))</span>
                                }
                                <span class="wal-k">pregão de @pregao.Data.ToString("dd/MM/yyyy")</span>
                            </div>
                        }
                        else
                        {
                            <span class="wal-k">Sem cotações ainda — a carga histórica pode estar em andamento.</span>
                        }
                    </div>
                </div>
                <div class="wal-ativo-acoes">
                    <MudButton Href="@($"transacoes?ativoId={ativo.Id}")" Variant="Variant.Filled" Color="Color.Primary"
                               DropShadow="false" StartIcon="@Icons.Material.Filled.Add">Transação de @ativo.Ticker</MudButton>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Mais ações" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Href="ativos" Icon="@Icons.Material.Outlined.Edit">Editar ativo</MudMenuItem>
                        <MudMenuItem OnClick="Sincronizar" Icon="@Icons.Material.Outlined.Sync" Disabled="sincronizando">Sincronizar cotações agora</MudMenuItem>
                    </MudMenu>
                </div>
            </div>
            <div class="wal-kpis">
                @if (detalhe.Posicao is { } p)
                {
                    @Kpi("Quantidade", Mascarar ? "•••" : Formatacao.QuantidadeCurta(p.Quantidade), ativo.Tipo == TipoAtivo.Tesouro ? "títulos" : "cotas")
                    @Kpi("Preço médio", Formatacao.Moeda(p.PrecoMedio), "", dica: "Custo ÷ quantidade")
                    @Kpi("Custo", Formatacao.Moeda(p.Custo, Mascarar), "")
                    @Kpi("Valor atual", p.Valor is decimal v ? Formatacao.Moeda(v, Mascarar) : "–", p.Peso is decimal w ? $"{Formatacao.PercentualSimples(w)} da carteira" : "")
                    @Kpi("Valorização", p.Valorizacao is decimal z ? Formatacao.Percentual(z) : "–",
                         p.Valor is decimal v2 ? Formatacao.MoedaComSinal(v2 - p.Custo, Mascarar) : "",
                         p.Valorizacao, "Cotação atual sobre o preço médio, sem proventos")
                    @Kpi("Proventos recebidos", Formatacao.Moeda(p.ProventosRecebidos, Mascarar), "desde a 1ª compra")
                    @Kpi("Resultado total", p.ResultadoTotal is decimal r ? Formatacao.MoedaComSinal(r, Mascarar) : "–",
                         p.ResultadoTotalPercentual is decimal rp ? $"{Formatacao.Percentual(rp)} sobre o investido" : "",
                         p.ResultadoTotal, "Valor atual − compras + vendas + proventos")
                    @Kpi("Yield on cost 12M", p.YieldOnCost12Meses is decimal yoc ? Formatacao.PercentualSimples(yoc, 2) : "–",
                         p.DividendYield12Meses is decimal dy ? $"DY 12M: {Formatacao.PercentualSimples(dy, 2)}" : "",
                         dica: "Proventos por ação dos últimos 12 meses ÷ preço médio (YoC) e ÷ cotação atual (DY)")
                }
                else if (detalhe.Encerrada is { } e)
                {
                    @Kpi("Situação", "Encerrada", e.UltimaVenda is DateOnly uv ? $"vendida em {uv:MM/yyyy}" : "")
                    @Kpi("Investido", Formatacao.Moeda(e.Investido, Mascarar), "")
                    @Kpi("Vendido", Formatacao.Moeda(e.Vendido, Mascarar), "")
                    @Kpi("Proventos recebidos", Formatacao.Moeda(e.Proventos, Mascarar), "")
                    @Kpi("Resultado realizado", Formatacao.MoedaComSinal(e.Resultado, Mascarar),
                         e.ResultadoPercentual is decimal erp ? $"{Formatacao.Percentual(erp)} sobre o investido" : "", e.Resultado)
                }
                else
                {
                    @Kpi("Situação", "Sem posição", "nenhuma transação deste ativo")
                }
            </div>
        </MudPaper>

        @if (detalhe.Serie.Count > 0)
        {
            <GraficoAtivo Detalhe="detalhe" Mascarar="Mascarar" Class="wal-s8 wal-xl9" />
        }

        <div class="wal-s4 wal-xl3 wal-coluna">
            @if (pregao is not null)
            {
                <CardPainel Titulo="Pregão" Subtitulo="@pregao.Data.ToString("dd/MM/yyyy")">
                    @if (ativo.Tipo != TipoAtivo.Tesouro)
                    {
                        <div class="wal-grade-kv">
                            <div class="wal-kv"><span class="wal-k">Abertura</span><span class="wal-forte">@Formatacao.Moeda(pregao.Abertura)</span></div>
                            <div class="wal-kv"><span class="wal-k">Volume</span><span class="wal-forte">@VolumeCurto(pregao.Volume)</span></div>
                            <div class="wal-kv"><span class="wal-k">Máxima</span><span class="wal-forte">@Formatacao.Moeda(pregao.Maxima)</span></div>
                            <div class="wal-kv"><span class="wal-k">Mínima</span><span class="wal-forte">@Formatacao.Moeda(pregao.Minima)</span></div>
                        </div>
                    }
                    @if (pregao.Minima52Semanas is decimal min && pregao.Maxima52Semanas is decimal max && max > min)
                    {
                        var posicao52 = Math.Clamp((pregao.Fechamento - min) / (max - min), 0, 1);
                        <div class="wal-faixa" role="img" aria-label="@($"Cotação a {posicao52:P0} da faixa de 52 semanas")">
                            <span class="wal-k">Faixa de 52 semanas</span>
                            <div class="wal-faixa-trilho">
                                <span class="wal-faixa-marca" style="left:@((posicao52 * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                            </div>
                            <div class="wal-faixa-limites wal-k"><span>@Formatacao.Moeda(min)</span><span>@Formatacao.Moeda(max)</span></div>
                        </div>
                    }
                </CardPainel>
            }
            @if (detalhe.EventosCorporativos.Count > 0)
            {
                <CardPainel Titulo="Eventos corporativos" Subtitulo="@detalhe.EventosCorporativos.Count.ToString()" SemEspacamento="true">
                    <MudSimpleTable Dense="true" Elevation="0" Class="wal-tabela">
                        <tbody>
                            @foreach (var e in detalhe.EventosCorporativos)
                            {
                                <tr>
                                    <td class="wal-k">@e.Data.ToString("dd/MM/yyyy")</td>
                                    <td><span class="wal-simbolo" style="color:#6250d6" aria-hidden="true">◆</span>@GraficoAtivo.DescricaoEvento(e)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </CardPainel>
            }
        </div>

        @if (detalhe.Proventos.Count > 0)
        {
            <CardPainel Titulo="Proventos" Subtitulo="valores brutos" Class="wal-s6" SemEspacamento="true">
                <div class="wal-card-corpo">
                    <MudChart T="double" ChartType="ChartType.StackedBar" ChartSeries="@seriesProventos" ChartLabels="@anosProventos"
                              ChartOptions="@opcoesProventos" Height="200px" Width="100%" />
                </div>
                <div class="wal-rolagem">
                    <MudSimpleTable Dense="true" Elevation="0" Class="wal-tabela">
                        <thead>
                            <tr>
                                <th title="Quem tinha o ativo nesta data tem direito ao provento">Data com</th>
                                <th>Pagamento</th>
                                <th>Tipo</th>
                                <th class="wal-num wal-sec">Qtd.</th>
                                <th class="wal-num wal-sec">Por ação</th>
                                <th class="wal-num" title="Valor bruto: JCP sem o desconto de 15% de IR">Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pr in detalhe.Proventos.Take(LinhasProventos))
                            {
                                <tr>
                                    <td class="wal-k">@(pr.DataCom?.ToString("dd/MM/yyyy") ?? "–")</td>
                                    <td>
                                        @if (pr.DataPagamentoEstimada)
                                        {
                                            <MudTooltip Text="Data estimada: o Yahoo informa só a data ex"><span class="wal-estimada">≈</span></MudTooltip>
                                        }
                                        @pr.DataPagamento.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>@GraficoAtivo.NomeProvento(pr.Tipo)</td>
                                    <td class="wal-num wal-sec">@(Mascarar ? "•••" : Formatacao.QuantidadeCurta(pr.Quantidade))</td>
                                    <td class="wal-num wal-sec">@pr.ValorPorAcao.ToString("C4", Formatacao.PtBR)</td>
                                    <td class="wal-num wal-forte">@Formatacao.Moeda(pr.Valor, Mascarar)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
                @if (detalhe.Proventos.Count > LinhasProventos)
                {
                    <div class="wal-card-rodape wal-k">Mais @(detalhe.Proventos.Count - LinhasProventos) proventos — a lista completa entra na tela de Eventos.</div>
                }
            </CardPainel>
        }

        <CardPainel Titulo="Transações" Subtitulo="@detalhe.Movimentacoes.Count.ToString()" Class="wal-s6" SemEspacamento="true">
            <Acoes>
                <MudLink Href="@($"transacoes?ativoId={ativo.Id}")" Typo="Typo.body2">Ver e editar</MudLink>
            </Acoes>
            <ChildContent>
                @if (detalhe.Movimentacoes.Count == 0)
                {
                    <div class="wal-card-corpo wal-k">Nenhuma transação deste ativo.</div>
                }
                else
                {
                    <div class="wal-rolagem">
                        <MudSimpleTable Dense="true" Elevation="0" Class="wal-tabela">
                            <thead>
                                <tr><th>Data</th><th>Tipo</th><th class="wal-num">Qtd.</th><th class="wal-num wal-sec">Preço</th><th class="wal-num">Total</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var m in detalhe.Movimentacoes.Take(LinhasTransacoes))
                                {
                                    var compra = m.Tipo == TipoMovimentacao.Compra;
                                    <tr>
                                        <td>@m.Data.ToString("dd/MM/yyyy")</td>
                                        <td><span class="wal-simbolo" style="color:@(compra ? "#0b7a34" : "#c5221f")" aria-hidden="true">@(compra ? "▲" : "▼")</span>@(compra ? "Compra" : "Venda")</td>
                                        <td class="wal-num">@(Mascarar ? "•••" : Formatacao.QuantidadeCurta(m.Quantidade))</td>
                                        <td class="wal-num wal-sec">@Formatacao.Moeda(m.PrecoUnitario)</td>
                                        <td class="wal-num wal-forte">@Formatacao.Moeda(m.Quantidade * m.PrecoUnitario + (compra ? m.Taxas : -m.Taxas), Mascarar)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                    @if (detalhe.Movimentacoes.Count > LinhasTransacoes)
                    {
                        <div class="wal-card-rodape">
                            <MudButton Href="@($"transacoes?ativoId={ativo.Id}")" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">
                                Ver todas (@detalhe.Movimentacoes.Count)
                            </MudButton>
                        </div>
                    }
                }
            </ChildContent>
        </CardPainel>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private const int LinhasProventos = 8;
    private const int LinhasTransacoes = 8;

    private bool carregando = true;
    private bool sincronizando;
    private int? idCarregado;
    private DetalheAtivoResponse? detalhe;
    private List<ChartSeries<double>> seriesProventos = [];
    private string[] anosProventos = [];
    private readonly StackedBarChartOptions opcoesProventos = new()
    {
        ChartPalette = ["#2a78d6", "#eb6834", "#1baf7a"],
        YAxisFormat = "N0"
    };

    private bool Mascarar => Preferencias.Mascarar;

    protected override void OnInitialized() => Preferencias.Mudou += AoMudarPreferencias;

    protected override async Task OnParametersSetAsync()
    {
        // Também roda em re-renders do pai sem troca de ativo — só recarrega se o Id mudou
        if (idCarregado == Id) return;
        idCarregado = Id;

        carregando = true;
        detalhe = await ScopedServices.GetRequiredService<IAnaliseCarteiraService>().ObterDetalheAtivoAsync(Id);
        if (detalhe is not null)
        {
            anosProventos = detalhe.ProventosPorAno.Select(a => a.Inicio.Year.ToString()).ToArray();
            ChartSeries<double> Serie(string nome, Func<ProventosPeriodoResponse, decimal> valor) =>
                new() { Name = nome, Data = new ChartData<double>(detalhe.ProventosPorAno.Select(a => (double)valor(a)).ToList()) };
            seriesProventos = [Serie("Dividendos", a => a.Dividendos), Serie("JCP", a => a.Jcp), Serie("Rendimentos", a => a.Rendimentos)];
        }
        carregando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Preferencias.CarregarAsync();
    }

    // Recarrega cotações, proventos e eventos desde 2020 em segundo plano (mesmo job do cadastro)
    private void Sincronizar()
    {
        sincronizando = true;
        ScopedServices.GetRequiredService<IAtivoJobScheduler>().EnfileirarCargaHistoricaInicial(Id);
        Snackbar.Add($"Sincronização de {detalhe?.Ativo.Ticker} enfileirada. Recarregue a página em alguns segundos.", Severity.Info);
    }

    private RenderFragment Kpi(string rotulo, string valor, string complemento, decimal? sinal = null, string? dica = null) => __builder =>
    {
        <div class="wal-kpi" title="@dica">
            <span class="wal-k">@rotulo</span>
            <span class="wal-kpi-valor @Formatacao.CorGanhoPerda(sinal)">@valor</span>
            @if (!string.IsNullOrEmpty(complemento))
            {
                <span class="wal-kpi-comp @Formatacao.CorGanhoPerda(sinal)">@complemento</span>
            }
        </div>
    };

    private static string VolumeCurto(long volume) => volume switch
    {
        >= 1_000_000 => $"{(volume / 1_000_000m).ToString("0.#", Formatacao.PtBR)} mi",
        >= 1_000 => $"{(volume / 1_000m).ToString("0.#", Formatacao.PtBR)} mil",
        _ => volume.ToString(Formatacao.PtBR)
    };

    private void AoMudarPreferencias() => InvokeAsync(StateHasChanged);

    protected override async ValueTask DisposeAsyncCore()
    {
        Preferencias.Mudou -= AoMudarPreferencias;
        await base.DisposeAsyncCore();
    }
}
