@* Marcador das telas do novo menu que ainda não foram implementadas *@
<MudPaper Outlined="true" Class="pa-8 d-flex flex-column align-center gap-3">
    <MudIcon Icon="@Icons.Material.Outlined.Construction" Size="Size.Large" Color="Color.Default" />
    <MudText Typo="Typo.h6">Em construção</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Fase @Fase do plano da nova interface.</MudText>
    @if (Destino is not null)
    {
        <MudButton Href="@Destino" Variant="Variant.Outlined" Color="Color.Primary">@DestinoTexto</MudButton>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public int Fase { get; set; }

    [Parameter] public string? Destino { get; set; }

    [Parameter] public string DestinoTexto { get; set; } = "Voltar ao Dashboard";
}
