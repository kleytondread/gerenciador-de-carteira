@page "/ativos"
@inherits PaginaCarteira
@inject IDialogService Dialogos
@inject ISnackbar Snackbar
@inject IJSRuntime Js

<PageTitle>Ativos rastreados - Gestor de Carteira B3</PageTitle>
<SectionContent SectionName="@TituloPagina.Secao">Ativos rastreados</SectionContent>

<MudTabs Elevation="0" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" Class="wal-abas" @bind-ActivePanelIndex="aba">
    <MudTabPanel Text="Ativos">
        @if (Carregando)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Carregando ativos" />
        }
        else
        {
            <div class="wal-painel">
                @if (Desatualizados.Count > 0 && filtro != Filtro.Desatualizados)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="wal-s12 wal-alerta"
                              ContentAlignment="HorizontalAlignment.Left">
                        <div class="wal-alerta-corpo">
                            <span>
                                <strong>@Desatualizados.Count @(Desatualizados.Count == 1 ? "ativo sem cotação nova" : "ativos sem cotação nova")</strong>
                                há mais de 5 pregões: @string.Join(", ", Desatualizados.Take(4).Select(a => a.Ticker))@(Desatualizados.Count > 4 ? "…" : "")
                            </span>
                            <span class="wal-alerta-acoes">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="() => filtro = Filtro.Desatualizados">Ver</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="PausarDesatualizadosAsync">Pausar todos</MudButton>
                            </span>
                        </div>
                    </MudAlert>
                }

                <CardPainel Titulo="Ativos" Subtitulo="@($"{ativos.Count(a => a.Rastreando)} rastreados")" SemEspacamento="true" Class="wal-s12">
                    <Acoes>
                        <MudTextField T="string" @bind-Value="busca" Immediate="true" DebounceInterval="200" Placeholder="Buscar ativo"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" Class="wal-busca" aria-label="Buscar ativo" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" DropShadow="false"
                                   StartIcon="@Icons.Material.Outlined.Sync" OnClick="SincronizarTudo">Sincronizar tudo</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" DropShadow="false"
                                   StartIcon="@Icons.Material.Outlined.Add" OnClick="() => AbrirDialogoAsync(null)">Adicionar ativo</MudButton>
                    </Acoes>
                    <ChildContent>
                        <div class="wal-filtros">
                            <MudChipSet T="Filtro" SelectionMode="SelectionMode.SingleSelection" @bind-SelectedValue="filtro"
                                        Size="Size.Small" Variant="Variant.Outlined" SelectedColor="Color.Primary" CheckMark="true" aria-label="Filtrar">
                                @foreach (var f in Enum.GetValues<Filtro>())
                                {
                                    <MudChip T="Filtro" Value="f" Default="@(f == Filtro.Todos)">@NomeFiltro(f) <span class="wal-k ml-1">@ativos.Count(a => Passa(a, f))</span></MudChip>
                                }
                            </MudChipSet>
                        </div>
                        @{ var lista = Visiveis().ToList(); }
                        <div class="wal-rolagem">
                            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="wal-tabela wal-tabela-acoes">
                                <thead>
                                    <tr>
                                        <th>Ativo</th>
                                        <th class="wal-sec">Tipo</th>
                                        <th class="wal-sec">Categoria</th>
                                        <th class="wal-sec">Fonte</th>
                                        <th class="wal-num">Na carteira</th>
                                        <th>Última cotação</th>
                                        <th class="wal-sec">Histórico desde</th>
                                        <th class="wal-num wal-sec">Proventos</th>
                                        <th title="Buscar cotações e proventos todo dia às 20h">Rastrear</th>
                                        <th class="wal-acoes-col"><span class="wal-oculto-leitor">Ações</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in lista)
                                    {
                                        <tr class="@(a.Rastreando ? null : "wal-linha-pausada")">
                                            <td>
                                                @if (a.Situacao == SituacaoNaCarteira.SemTransacoes)
                                                {
                                                    <span class="wal-forte">@a.Ticker</span>
                                                }
                                                else
                                                {
                                                    <a href="@($"posicoes/{a.Id}")" class="wal-forte">@a.Ticker</a>
                                                }
                                                <div class="wal-nome">@a.Nome</div>
                                            </td>
                                            <td class="wal-sec">@Formatacao.NomeTipo(a.Tipo)</td>
                                            <td class="wal-sec"><span class="wal-quadrado" style="background:@CoresSeries.Cor(a.Categoria)"></span>@CoresSeries.NomeCategoria(a.Categoria)</td>
                                            <td class="wal-sec wal-k">@(a.Tipo == TipoAtivo.Tesouro ? "Tesouro Transparente" : "Yahoo Finance")</td>
                                            <td class="wal-num">
                                                @switch (a.Situacao)
                                                {
                                                    case SituacaoNaCarteira.Aberta:
                                                        @(Mascarar ? "•••" : Formatacao.QuantidadeCurta(a.Quantidade))
                                                        break;
                                                    case SituacaoNaCarteira.Encerrada:
                                                        <span class="wal-k">Encerrada</span>
                                                        break;
                                                    default:
                                                        <span class="wal-k">–</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                <span class="wal-cotacao-data">@(a.UltimaCotacao?.ToString("dd/MM/yyyy") ?? "–")</span>
                                                @Saude(a)
                                            </td>
                                            <td class="wal-sec">@(a.PrimeiraCotacao?.ToString("MM/yyyy") ?? "–")</td>
                                            <td class="wal-num wal-sec">@(a.Proventos > 0 ? a.Proventos : "–")</td>
                                            <td>
                                                <MudSwitch T="bool" Value="a.Rastreando" ValueChanged="v => DefinirRastreamentoAsync(a, v)" Color="Color.Primary"
                                                           Disabled="@(alterando == a.Id)" aria-label="@($"Rastrear {a.Ticker}")" />
                                            </td>
                                            <td class="wal-num wal-acoes-col">
                                                <MudTooltip Text="Baixar o histórico inteiro de novo">
                                                    <MudIconButton Icon="@Icons.Material.Outlined.CloudSync" Size="Size.Small" OnClick="() => RecarregarHistorico(a)"
                                                                   aria-label="@($"Baixar de novo o histórico de {a.Ticker}")" />
                                                </MudTooltip>
                                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => AbrirDialogoAsync(a)"
                                                               aria-label="@($"Editar {a.Ticker}")" />
                                            </td>
                                        </tr>
                                    }
                                    @if (lista.Count == 0)
                                    {
                                        <tr><td colspan="10" class="wal-vazio">@(ativos.Count == 0 ? "Nenhum ativo cadastrado ainda." : "Nenhum ativo encontrado.")</td></tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                    </ChildContent>
                </CardPainel>
            </div>
        }
    </MudTabPanel>

    <MudTabPanel Text="Índices">
        <div class="wal-painel">
            <CardPainel Titulo="Índices de referência" Subtitulo="Comparados com a carteira no Dashboard" SemEspacamento="true" Class="wal-s8">
                <Acoes>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" DropShadow="false"
                               StartIcon="@Icons.Material.Outlined.Sync" OnClick="SincronizarIndices">Sincronizar índices</MudButton>
                </Acoes>
                <ChildContent>
                    <div class="wal-rolagem">
                        <MudSimpleTable Dense="true" Elevation="0" Class="wal-tabela">
                            <thead>
                                <tr>
                                    <th>Índice</th>
                                    <th class="wal-sec">Fonte</th>
                                    <th class="wal-num">Último valor</th>
                                    <th>Atualizado</th>
                                    <th class="wal-sec">Desde</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in indices)
                                {
                                    var info = Info(i.Indice);
                                    <tr>
                                        <td><span class="wal-forte">@info.Nome</span><div class="wal-nome">@info.Descricao</div></td>
                                        <td class="wal-sec wal-k">@info.Fonte</td>
                                        <td class="wal-num">@(i.UltimoValor is decimal v ? info.Formatar(v) : "–")</td>
                                        <td>
                                            <span class="wal-cotacao-data">@(i.UltimaData?.ToString("dd/MM/yyyy") ?? "–")</span>
                                            @SaudeIndice(i, info.Mensal)
                                        </td>
                                        <td class="wal-sec">@(i.PrimeiraData?.ToString("MM/yyyy") ?? "–")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                </ChildContent>
            </CardPainel>

            <CardPainel Titulo="IPCA + X%" Subtitulo="Meta de rentabilidade real" Class="wal-s4">
                <div class="wal-formulario">
                    <MudNumericField T="decimal" Value="taxaIpcaMais" ValueChanged="TrocarTaxaIpcaMaisAsync" Label="Taxa real ao ano"
                                     Variant="Variant.Outlined" Min="0" Max="20" Step="0.5m" Format="0.##" Culture="@Formatacao.PtBR"
                                     Adornment="Adornment.End" AdornmentText="% a.a." />
                    <div class="wal-ajuda">
                        <span>Aparece como <strong>@CoresSeries.Nome(Benchmark.IpcaMais, taxaIpcaMais / 100)</strong> no gráfico de rentabilidade</span>
                    </div>
                </div>
            </CardPainel>
        </div>
    </MudTabPanel>
</MudTabs>

@code {
    private IAtivoService AtivoService => ScopedServices.GetRequiredService<IAtivoService>();
    private IAtivoJobScheduler Jobs => ScopedServices.GetRequiredService<IAtivoJobScheduler>();

    private enum Filtro { Todos, NaCarteira, Encerrados, SemTransacoes, Desatualizados, Pausados }

    private sealed record InfoIndice(string Nome, string Descricao, string Fonte, bool Mensal, Func<decimal, string> Formatar);

    private int aba;
    private List<AtivoRastreadoResponse> ativos = [];
    private List<SituacaoIndiceResponse> indices = [];
    private string? busca;
    private Filtro filtro = Filtro.Todos;
    private int? alterando;
    // Em pontos percentuais (6 = IPCA + 6% a.a.), como o usuário digita
    private decimal taxaIpcaMais = CoresSeries.TaxaIpcaMaisPadrao * 100;

    /// <summary>Rastreados que pararam de receber cotação (ex.: saíram da bolsa ou mudaram de ticker).</summary>
    private List<AtivoRastreadoResponse> Desatualizados => ativos.Where(a => a.Rastreando && a.Saude == SaudeCotacoes.Desatualizada).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var salvo = await Js.InvokeAsync<string?>("walPreferencias.obter", CoresSeries.ChaveTaxaIpcaMais);
        taxaIpcaMais = CoresSeries.LerTaxaIpcaMais(salvo) * 100;
        StateHasChanged();
    }

    // Também recarrega quando a carteira muda: "Na carteira" depende das transações
    protected override async Task CarregarAsync()
    {
        ativos = await AtivoService.ObterRastreadosAsync();
        indices = await ScopedServices.GetRequiredService<IIndicesReferenciaService>().ObterSituacaoAsync();
    }

    private IEnumerable<AtivoRastreadoResponse> Visiveis() =>
        ativos.Where(a => Passa(a, filtro) && Busca.Encontra(busca, a.Ticker, a.Nome));

    private static bool Passa(AtivoRastreadoResponse a, Filtro f) => f switch
    {
        Filtro.NaCarteira => a.Situacao == SituacaoNaCarteira.Aberta,
        Filtro.Encerrados => a.Situacao == SituacaoNaCarteira.Encerrada,
        Filtro.SemTransacoes => a.Situacao == SituacaoNaCarteira.SemTransacoes,
        Filtro.Desatualizados => a.Rastreando && a.Saude == SaudeCotacoes.Desatualizada,
        Filtro.Pausados => !a.Rastreando,
        _ => true
    };

    private static string NomeFiltro(Filtro f) => f switch
    {
        Filtro.NaCarteira => "Na carteira",
        Filtro.Encerrados => "Encerrados",
        Filtro.SemTransacoes => "Sem transações",
        Filtro.Desatualizados => "Desatualizados",
        Filtro.Pausados => "Pausados",
        _ => "Todos"
    };

    // Ícone + texto: o estado nunca depende só da cor
    private static RenderFragment Selo(string classe, string icone, string texto, string? dica = null) => __builder =>
    {
        <span class="@($"wal-saude {classe}")" title="@dica"><MudIcon Icon="@icone" Size="Size.Small" />@texto</span>
    };

    private static RenderFragment Saude(AtivoRastreadoResponse a) => !a.Rastreando
        ? Selo("wal-saude-pausado", Icons.Material.Outlined.PauseCircle, "Pausado", "Não busca dados novos")
        : a.Saude switch
        {
            SaudeCotacoes.EmDia => Selo("wal-saude-ok", Icons.Material.Outlined.CheckCircle, "Em dia"),
            SaudeCotacoes.Desatualizada => Selo("wal-saude-atraso", Icons.Material.Outlined.Warning, "Desatualizado",
                "A fonte parou de mandar cotações. Se o ativo saiu da bolsa, pause o rastreamento."),
            _ => Selo("wal-saude-sem", Icons.Material.Outlined.HourglassEmpty, "Sem cotação", "Recém-cadastrado ou ticker não encontrado na fonte")
        };

    private static RenderFragment SaudeIndice(SituacaoIndiceResponse i, bool mensal)
    {
        if (i.UltimaData is not DateOnly ultima)
            return Selo("wal-saude-sem", Icons.Material.Outlined.HourglassEmpty, "Sem dados", "Rode Sincronizar índices");
        // O IPCA sai por volta do dia 10 do mês seguinte: até ~70 dias de defasagem é normal
        var limite = DateOnly.FromDateTime(DateTime.Today).AddDays(mensal ? -70 : -5);
        return ultima >= limite
            ? Selo("wal-saude-ok", Icons.Material.Outlined.CheckCircle, "Em dia")
            : Selo("wal-saude-atraso", Icons.Material.Outlined.Warning, "Desatualizado");
    }

    private static string Pontos(decimal v) => v.ToString("N0", Formatacao.PtBR) + " pts";

    // CDI e IPCA ficam guardados como fração (0,00055 ao dia; 0,0048 no mês)
    private static InfoIndice Info(IndiceReferencia indice) => indice switch
    {
        IndiceReferencia.CDI => new("CDI", "Taxa DI, anualizada em 252 dias úteis", "Banco Central", false,
            v => $"{((decimal)Math.Pow(1 + (double)v, 252) - 1).ToString("P2", Formatacao.PtBR)} a.a."),
        IndiceReferencia.IPCA => new("IPCA", "Inflação oficial", "Banco Central", true,
            v => $"{v.ToString("P2", Formatacao.PtBR)} no mês"),
        IndiceReferencia.IBOV => new("IBOV", "Ibovespa", "Yahoo Finance", false, Pontos),
        IndiceReferencia.IDIV => new("IDIV", "Aproximado pelo DIVO11 com proventos", "Yahoo Finance", false, v => Formatacao.Moeda(v)),
        IndiceReferencia.SP500 => new("S&P 500", "Em dólar; convertido pela PTAX", "Yahoo Finance", false, Pontos),
        IndiceReferencia.PTAX => new("PTAX", "Dólar de venda", "Banco Central", false, v => Formatacao.Moeda(v)),
        _ => new(indice.ToString(), "", "", false, v => v.ToString("N2", Formatacao.PtBR))
    };

    private async Task AbrirDialogoAsync(AtivoRastreadoResponse? ativo)
    {
        var parametros = new DialogParameters<DialogAtivo> { { d => d.Editando, ativo } };
        var dialogo = await Dialogos.ShowAsync<DialogAtivo>(null, parametros,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var resultado = await dialogo.Result;
        if (resultado is not { Canceled: false, Data: string ticker }) return;

        Snackbar.Add(ativo is null
            ? $"{ticker} cadastrado. O histórico está sendo baixado em segundo plano."
            : $"{ticker} atualizado.", Severity.Success);
        await RecarregarAsync();
    }

    private async Task DefinirRastreamentoAsync(AtivoRastreadoResponse a, bool rastrear)
    {
        if (!rastrear && a.Situacao == SituacaoNaCarteira.Aberta)
        {
            var confirmado = await Dialogos.ShowMessageBoxAsync(
                $"Pausar {a.Ticker}?",
                "Ele está na carteira: sem cotações novas, o valor dele fica parado na última cotação e proventos novos não chegam.",
                yesText: "Pausar", cancelText: "Cancelar");
            if (confirmado != true) return;
        }

        alterando = a.Id;
        try
        {
            var resultado = await AtivoService.DefinirRastreamentoAsync(a.Id, rastrear);
            if (!resultado.Sucesso)
            {
                Snackbar.Add(resultado.Erro ?? "Não foi possível alterar.", Severity.Error);
                return;
            }
            Snackbar.Add(rastrear ? $"{a.Ticker} volta a ser atualizado na próxima sincronização." : $"{a.Ticker} pausado.", Severity.Normal);
            await RecarregarAsync();
        }
        finally
        {
            alterando = null;
        }
    }

    private async Task PausarDesatualizadosAsync()
    {
        var alvos = Desatualizados;
        var naCarteira = alvos.Count(a => a.Situacao == SituacaoNaCarteira.Aberta);
        var confirmado = await Dialogos.ShowMessageBoxAsync(
            $"Pausar {alvos.Count} {(alvos.Count == 1 ? "ativo" : "ativos")}?",
            string.Join(", ", alvos.Select(a => a.Ticker))
                + (naCarteira > 0 ? $". {naCarteira} ainda {(naCarteira == 1 ? "está" : "estão")} na carteira e o valor fica parado na última cotação." : "."),
            yesText: "Pausar", cancelText: "Cancelar");
        if (confirmado != true) return;

        foreach (var a in alvos)
            await AtivoService.DefinirRastreamentoAsync(a.Id, false);
        Snackbar.Add($"{alvos.Count} {(alvos.Count == 1 ? "ativo pausado" : "ativos pausados")}.", Severity.Normal);
        await RecarregarAsync();
    }

    private void RecarregarHistorico(AtivoRastreadoResponse a)
    {
        Jobs.EnfileirarCargaHistoricaInicial(a.Id);
        Snackbar.Add($"Baixando o histórico de {a.Ticker} em segundo plano.", Severity.Normal);
    }

    private void SincronizarTudo()
    {
        Snackbar.Add(Jobs.EnfileirarSincronizacaoGeral()
            ? "Sincronização iniciada em segundo plano. As telas se atualizam sozinhas ao terminar."
            : "Já há uma atualização em andamento.", Severity.Normal);
    }

    private void SincronizarIndices()
    {
        Jobs.EnfileirarSincronizacaoIndices();
        Snackbar.Add("Atualizando os índices em segundo plano.", Severity.Normal);
    }

    private async Task TrocarTaxaIpcaMaisAsync(decimal pontos)
    {
        taxaIpcaMais = Math.Clamp(pontos, 0, 20);
        await Js.InvokeVoidAsync("walPreferencias.definir", CoresSeries.ChaveTaxaIpcaMais, CoresSeries.GravarTaxaIpcaMais(taxaIpcaMais / 100));
    }
}
